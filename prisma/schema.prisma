  @@index([workerId, status])
  @@index([vehicleJobId, status])
  @@map("vehicle_job_assignments")
}

model WorkerAssignmentEvent {
  id           Int      @id @default(autoincrement())
  assignmentId Int      @map("assignment_id")
  workerId     Int      @map("worker_id")
  vehicleJobId Int      @map("vehicle_job_id")
  eventType    String   @map("event_type") @db.VarChar(30)
  occurredAt   DateTime @map("occurred_at") @db.Timestamp(3)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  assignment VehicleJobAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  worker     MasterWorker         @relation("WorkerAssignmentEventWorker", fields: [workerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleJob VehicleJob           @relation(fields: [vehicleJobId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assignmentId, eventType])
  @@index([workerId, occurredAt])
  @@index([workerId, eventType, occurredAt])
  @@index([assignmentId, occurredAt])
  @@index([vehicleJobId])
  @@index([eventType, occurredAt])
  @@map("worker_assignment_events")
}

model UserSession {
  id               Int       @id @default(autoincrement())
  accountId        Int       @map("account_id")
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(512)
  deviceId         String    @map("device_id") @db.VarChar(255)
  deviceName       String    @map("device_name") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  isActive         Boolean   @default(true) @map("is_active")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at") @db.Timestamp(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamp(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamp(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([accountId, isActive])
  @@map("user_sessions")
}

model WorkerPushToken {
  id           Int       @id @default(autoincrement())
  workerId     Int       @map("worker_id")
  workerCode   String    @map("worker_code") @db.VarChar(100)
  sessionId    Int?      @map("session_id")
  deviceId     String    @map("device_id") @db.VarChar(255)
  platform     String    @default("unknown") @db.VarChar(30)
  fcmToken     String    @map("fcm_token") @db.Text
  fcmTokenHash String    @map("fcm_token_hash") @db.VarChar(64)
  isActive     Boolean   @default(true) @map("is_active")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamp(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamp(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  worker  MasterWorker   @relation(fields: [workerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session WorkerSession? @relation("WorkerPushTokenSession", fields: [sessionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([workerId, deviceId, platform])
  @@index([fcmTokenHash])
  @@index([workerId, isActive])
  @@index([sessionId, isActive])
  @@map("worker_push_tokens")
}

// Central audit log for Admin actions that need a reason + actor + timeline entry (override
// count, force wait, release workers, force worker status, ...). Kept generic/append-only
// rather than adding cancelled_by/waited_by/released_by columns scattered across multiple
// tables — Work History's Timeline reads this directly as ADMIN_ACTION entries.
//
// vehicleJobId is nullable because some actions (e.g. force worker status) target a Worker with
// no VehicleJob context at all — an idle worker sitting in the queue has none.
model AdminActionLog {
  id             Int      @id @default(autoincrement())
  vehicleJobId   Int?     @map("vehicle_job_id")
  gateTicketId   Int?     @map("gate_ticket_id")
  // Business Ticket (market job) this action targeted, when the action is scoped narrower than
  // the whole vehicle job but broader than a single booth (e.g. cancelling a whole TicketNo).
  marketJobId    Int?     @map("market_job_id")
  actionType     String   @map("action_type") @db.VarChar(40)
  reasonCode     String?  @map("reason_code") @db.VarChar(50)
  reasonText     String?  @map("reason_text") @db.Text
  actorAccountId Int      @map("actor_account_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  vehicleJob VehicleJob? @relation(fields: [vehicleJobId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gateTicket GateTicket? @relation(fields: [gateTicketId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  marketJob  MarketJob?  @relation(fields: [marketJobId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor      Account     @relation("AdminActionLogActor", fields: [actorAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([vehicleJobId, createdAt])
  @@index([gateTicketId, createdAt])
  @@index([marketJobId, createdAt])
  @@index([actionType, createdAt])
  @@map("admin_action_logs")
}

// Append-only auth/security event log (27.12, phase 1: login/logout/force-login only) — separate
// from AdminActionLog because that table requires a non-null Account actor and is scoped to
// job/ticket operational actions, while a failed login may have no resolvable actor at all (unknown
// username). actorAccountId/actorWorkerId are plain non-FK ids (no relation, mirroring how worker
// refs are already handled loosely elsewhere in this schema) so a later account/worker deletion can
// never be blocked by, or silently cascade into, security history. actorUsername/actorFullName are
// denormalized snapshots taken at write time, not joined at read time — keeps this table fully
// self-contained for the merged GET /api/admin/audit/events timeline.
model SecurityAuditLog {
  id            Int      @id @default(autoincrement())
  eventType     String   @map("event_type") @db.VarChar(50)
  outcome       String   @db.VarChar(20)
  // "admin" | "worker" | null (actor could not be resolved at all, e.g. login with an unknown
  // username — never fabricate a value here just to fill the column)
  actorType     String?  @map("actor_type") @db.VarChar(20)
  actorAccountId Int?    @map("actor_account_id")
  actorWorkerId Int?     @map("actor_worker_id")
  actorUsername String?  @map("actor_username") @db.VarChar(100)
  actorFullName String?  @map("actor_full_name") @db.VarChar(255)
  sessionId     Int?     @map("session_id")
  requestId     String?  @map("request_id") @db.VarChar(100)
  ipAddress     String?  @map("ip_address") @db.VarChar(100)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  failureCode   String?  @map("failure_code") @db.VarChar(50)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  @@index([eventType, createdAt])
  @@index([actorAccountId])
  @@index([actorWorkerId])
  @@map("security_audit_logs")
}
