// TicketWorker = a worker's roster membership on one Business Ticket (MarketJob),
// not one booth. This is the participation/financial-eligibility record — see
// VehicleJobAssignment for the vehicle-level (TicketNumber) team membership.
model TicketWorker {
  id                  Int                         @id @default(autoincrement())
  marketJobId         Int                         @map("market_job_id")
  workerId            Int                         @map("worker_id")
  status              String                      @default("WORKING") @db.VarChar(30)
  finalEarningAmount  Decimal?                    @map("final_earning_amount") @db.Decimal(18, 2)
  joinedAt            DateTime                    @default(now()) @map("joined_at") @db.Timestamp(3)
  cancelledAt         DateTime?                   @map("cancelled_at") @db.Timestamp(3)
  completedAt         DateTime?                   @map("completed_at") @db.Timestamp(3)
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt           DateTime                    @updatedAt @map("updated_at") @db.Timestamp(3)
  marketJob           MarketJob                   @relation(fields: [marketJobId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  worker              MasterWorker                @relation(fields: [workerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments            TicketWorkerPayment[]
  boothSnapshots      GateTicketWorkerSnapshot[]
  boothExclusions     GateTicketWorkerExclusion[]
  submissionSnapshots SubmissionWorkerSnapshot[]

  @@unique([marketJobId, workerId])
  @@index([workerId, status])
  @@index([marketJobId, status])
  @@map("ticket_workers")
}

// Snapshot of which TicketWorker rows were still WORKING at the moment one specific booth
// (GateTicket) was confirmed (vendor confirm or auto-confirm timeout) — captured once, in
// confirmTicketCompletion. This is the authoritative worker list + divisor used for THIS booth's
// products at financialize time, instead of the Ticket-wide roster taken once at the very end of
// the whole Business Ticket. This keeps payout fair per booth: a worker cancelled from the team
// after this booth already confirmed does not shrink this booth's divisor, and a worker who was
// active when this booth confirmed still gets counted here even if cancelled from the Ticket later.
model GateTicketWorkerSnapshot {
  id             Int      @id @default(autoincrement())
  gateTicketId   Int      @map("gate_ticket_id")
  ticketWorkerId Int      @map("ticket_worker_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  gateTicket   GateTicket   @relation(fields: [gateTicketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ticketWorker TicketWorker @relation(fields: [ticketWorkerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([gateTicketId, ticketWorkerId])
  @@index([ticketWorkerId])
  @@map("gate_ticket_worker_snapshots")
}

// Snapshot of which TicketWorker rows were WORKING at the exact moment one specific
// TicketCompletionSubmission was created (in createTicketCompletionSubmission) — the same set used
// for that submission's workerCountSnapshot, just as a full roster instead of a count. Distinct
// from GateTicketWorkerSnapshot (captured later, at booth Confirm time): a worker cancelled or
// reassigned between Submit and Confirm makes these two snapshots diverge — this one answers "who
// was on the team when the count was actually submitted", used by Work History's
// SubmissionWorkerSnapshot[], never the payout divisor (GateTicketWorkerSnapshot stays the only
// source of truth for that).
model SubmissionWorkerSnapshot {
  id             Int      @id @default(autoincrement())
  submissionId   Int      @map("submission_id")
  ticketWorkerId Int      @map("ticket_worker_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  submission   TicketCompletionSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ticketWorker TicketWorker               @relation(fields: [ticketWorkerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([submissionId, ticketWorkerId])
  @@index([ticketWorkerId])
  @@map("submission_worker_snapshots")
}

// Admin ถอน worker คนหนึ่งออกจากแค่ Booth เดียว (payout divisor ของ booth นี้เท่านั้น) โดยไม่แตะ
// TicketWorker.status เลย — worker ยังเป็นสมาชิก WORKING ของ Business Ticket ตามปกติ ยังทำ Booth
// อื่นในใบเดียวกันต่อได้ ต่างจาก cancelTicketWorker (ถอนออกทั้ง Business Ticket) ตรงนี้แคบกว่า
// อีกชั้น — ถอนได้จนกว่า Booth นั้นจะเคยถูกส่งยอดแล้ว (เหมือน guard ของการยกเลิกทั้ง Booth)
// confirmTicketCompletion ต้อง exclude worker ที่มีแถวนี้ตอนสร้าง GateTicketWorkerSnapshot ของ
// Booth นั้น
model GateTicketWorkerExclusion {
  id             Int      @id @default(autoincrement())
  gateTicketId   Int      @map("gate_ticket_id")
  ticketWorkerId Int      @map("ticket_worker_id")
  cancelledAt    DateTime @default(now()) @map("cancelled_at") @db.Timestamp(3)

  gateTicket   GateTicket   @relation(fields: [gateTicketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ticketWorker TicketWorker @relation(fields: [ticketWorkerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([gateTicketId, ticketWorkerId])
  @@index([ticketWorkerId])
  @@map("gate_ticket_worker_exclusions")
}

model TicketCompletionSubmission {
  id                   Int       @id @default(autoincrement())
  ticketId             Int       @map("ticket_id")
  // Submitter คือ Admin หรือ Worker อย่างใดอย่างหนึ่งเท่านั้น (ดู submittedByRole) — แยกเป็นสอง FK
  // คนละตารางเพราะ Worker ไม่มี Account record อีกต่อไปตั้งแต่ MasterWorker refactor พอดี ๆ กับ role
  // ต้องมีค่าตรงกับ FK ที่ไม่ null เสมอ (admin -> submittedByAccountId, worker -> submittedByWorkerId)
  submittedByAccountId Int?      @map("submitted_by_account_id")
  submittedByWorkerId  Int?      @map("submitted_by_worker_id")
  // Snapshot of the submitting account's role at the moment of THIS submission ("worker" or
  // "admin" — see TICKET_SUBMITTER_ROLE). Must always be written explicitly by the service that
  // creates this row, never derived by joining Account.role at read time — Account.role can
  // change later (e.g. an admin account demoted), which would otherwise silently rewrite history.
  submittedByRole      String    @map("submitted_by_role") @db.VarChar(20)
  status               String    @default("DELIVERED") @db.VarChar(30)
  confirmedAt          DateTime? @map("confirmed_at") @db.Timestamp(3)
  rejectedAt           DateTime? @map("rejected_at") @db.Timestamp(3)
  // Reject reason captured per-submission at the moment of this specific reject, unlike
  // GateTicket.rejectReason which only ever holds the latest/current reason and gets
  // overwritten by later submissions. Used for Work History's per-rejection audit trail.
  rejectReason         String?   @map("reject_reason") @db.Text
  resolvedByLineUserId String?   @map("resolved_by_line_user_id") @db.VarChar(255)
  // Count of TicketWorker rows with status = WORKING at the exact moment this submission was
  // created (after syncTicketWorkersFromVehicleAssignments), for Work History's per-submission
  // Booth worker_count. Distinct from GateTicketWorkerSnapshot (roster at Confirm/Financialize
  // time) and from Financial worker_count (TicketProductFinancial.workerCount) — never mix the
  // three. Nullable because rows created before this feature have no reliable historical count;
  // never backfilled from current data.
  workerCountSnapshot  Int?      @map("worker_count_snapshot")
  // VehicleJobAssignment that the submitting worker was actively working under at the exact
  // moment this submission was created (resolved the same way as
  // findCurrentAssignmentByVehicleJobRefAndWorker: latest accepted, not-yet-terminated assignment
  // for that worker on this VehicleJob). Used by Work History's Workers[] to attribute
  // submitted_at to the correct work-cycle instead of guessing across transactions. Null for
  // admin-submitted-on-behalf rows (the admin account has no assignment of its own) and for rows
  // created before this feature — never backfilled from current data.
  assignmentId         Int?      @map("assignment_id")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  ticket             GateTicket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  submittedByAccount Account?                   @relation("TicketCompletionSubmitterAdmin", fields: [submittedByAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  submittedByWorker  MasterWorker?              @relation("TicketCompletionSubmitterWorker", fields: [submittedByWorkerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignment         VehicleJobAssignment?      @relation(fields: [assignmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ratings            TicketRating[]
  lineActionTokens   LineActionToken[]
  workerSnapshots    SubmissionWorkerSnapshot[]

  @@index([ticketId, status])
  @@index([resolvedByLineUserId])
  @@index([assignmentId])
  @@index([submittedByWorkerId])
  @@map("ticket_completion_submissions")
}

