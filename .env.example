# Runtime
# Hosting platforms such as Render inject PORT automatically.
# Keep this value for local development only.
PORT=8080
HOST=0.0.0.0
# development here is the local-dev default only. Any real deployment (Render, or a self-managed
# droplet running docker-compose's api-prod/production target) MUST set this to "production" in
# its own .env — it is not injected automatically outside Render. This drives src/config/logger.ts
# (JSON stdout vs pino-pretty), src/config/env.config.ts's stricter production validation, and
# Dockerfile's `production` build stage already bakes ENV NODE_ENV=production into the image, but
# docker-compose's env_file: .env still overrides that at container start if this file says
# otherwise — keep them in sync.
NODE_ENV=development
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=20000

# CORS
# Local development may use "*".
# Production requires an explicit origin unless ALLOW_CORS_WILDCARD=true
# is intentionally enabled for a shared development/test environment.
CORS_ORIGIN=*
ALLOW_CORS_WILDCARD=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_CLEANUP_INTERVAL_MS=60000

# PostgreSQL / Prisma
# Render deployment should use the Render PostgreSQL internal connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5433/labor_project

# Docker API container -> local PostgreSQL on host machine
DOCKER_DATABASE_URL=postgresql://postgres:password@host.docker.internal:5433/labor_project

# Redis / BullMQ
# Render deployment should use the Render Key Value internal connection string.
REDIS_URL=redis://localhost:6380
REDIS_HOST_PORT=6380
REDIS_WORKER_QUEUE_KEY=labor:worker:queue
REDIS_WORKER_STATUS_KEY_PREFIX=labor:worker:status:
REDIS_WORKER_PRESENCE_KEY_PREFIX=labor:worker:presence:
WORKER_PRESENCE_STALE_SECONDS=90
WORKER_SOCKET_DISCONNECT_GRACE_MS=15000
REDIS_WORKER_BREAK_COUNT_KEY_PREFIX=labor:worker:break-count:
BULLMQ_ASSIGNMENT_TIMEOUT_QUEUE=labor-assignment-timeouts
BULLMQ_WORKER_BREAK_RETURN_QUEUE=labor-worker-break-returns
BULLMQ_LINE_MESSAGE_QUEUE=labor-line-messages

# Uploads
# Render Free uses an ephemeral filesystem.
# Uploaded files can be lost after restart, redeploy, or idle spin-down.
UPLOAD_DIR=uploads

# JWT
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_LOGIN_CHALLENGE_SECRET=change-this-login-challenge-secret
# Signs vendor action tokens (LINE confirm/reject/rate buttons) sent to an external Vendor —
# must be its own secret, separate from JWT_ACCESS_SECRET, so it can be rotated independently
# without invalidating admin/worker sessions
VENDOR_ACTION_TOKEN_SECRET=change-this-vendor-action-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_LOGIN_CHALLENGE_EXPIRES_IN=5m

# Refresh token storage hash
REFRESH_TOKEN_HASH_SECRET=change-this-refresh-token-hash-secret

# LINE OA. Required in production because the app serves LINE webhook and
# outbound LINE message flows.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Firebase / FCM Worker Push. Required in production when Worker Push is enabled.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Logging / Error Tracking
# Minimum pino log level to emit: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info
# Sentry DSN for exception tracking (5xx errors). Leave empty to disable Sentry entirely — safe no-op.
SENTRY_DSN=
# Optional: forward stdout JSON logs to an external log service (e.g. Better Stack, Grafana Cloud
# Loki) via a push-based approach. NOT USED if self-hosting Loki via docker-compose's "logging"
# profile (Promtail pulls logs directly from the Docker log driver instead — see below). Left here
# unused/empty for now in case the project switches back to an external push-based service later.
# Not wired to any specific vendor yet — reserved for when a log service is actually subscribed to.
LOG_SERVICE_URL=
LOG_SERVICE_TOKEN=

# Self-hosted log stack (Grafana Loki + Promtail + Grafana) — docker-compose "logging" profile.
# Loki/Promtail need no credentials (not exposed outside the compose network). Grafana's admin
# login must be set here — if left empty, Grafana falls back to its own insecure admin/admin
# default. Required before exposing Grafana's port 3000 on a public host; also restrict port 3000
# with a firewall rule (see README) since this password is the only auth layer in front of it.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=